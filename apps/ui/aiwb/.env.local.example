# Standalone mode configs
STANDALONE_MODE=true
DEFAULT_NAMESPACE=workbench
API_KEYS_MANAGEMENT_ENABLED=true

# When STANDALONE_MODE is false, set AIRM_APP_URL to show a link to the AIRM app in the user menu.
# AIRM_APP_URL=http://localhost:8010

# Login through any OIDC issuer. Keycloak is one of them. The KEYCLOAK_ID,
# KEYCLOAK_SECRET, KEYCLOAK_ISSUER and KEYCLOAK_ISSUER_INTERNAL_URL names
# still work as a fallback.
NEXTAUTH_SECRET="something-random"
OIDC_CLIENT_ID="354a0fa1-35ac-4a6d-9c4d-d661129c2cd0"
# OIDC_SCOPES="openid profile email"

# For local connection
NEXTAUTH_URL=http://localhost:8011
OIDC_CLIENT_SECRET="rOTRdBzVy9ktgbFBTTmSZRBUJFdxPjBF"
AIRM_API_SERVICE_URL=http://localhost:8002
OIDC_ISSUER=http://localhost:8080/realms/airm
# The issuer as this process reaches it, when it differs from OIDC_ISSUER.
# OIDC_ISSUER_INTERNAL_URL=http://keycloak:8080/realms/airm

# For remote cluster connection
#NEXTAUTH_URL=http://localhost:8002
#OIDC_CLIENT_SECRET="ask the team for the secret"
#AIRM_API_SERVICE_URL=http://localhost:8003
#OIDC_ISSUER=https://kc.<your-domain>/realms/airm
